# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/
# Dedicated venv created on-demand by scripts/setup_localstack_and_postgres.sh
.venv-seed-db/

# --- DVC ---
# .dvc/config (the remote URL) is intentionally committed so the whole team
# shares the same S3 bucket; only the local scratch/runtime dirs are ignored.
.dvc/tmp/
.dvc/cache/
.dvc/config.local

# --- Terraform ---
deploy/terraform/.terraform/
deploy/terraform/.terraform.lock.hcl
deploy/terraform/terraform.tfstate
deploy/terraform/terraform.tfstate.backup
deploy/terraform/*.tfvars
deploy/terraform/*.tfvars.json
# Generated by scripts/deploy_k3s_*.bat from the live cluster - contains a
# real client certificate/key for full admin access to the K3s API server.
deploy/terraform/k3s.yaml

# --- Docker Compose secrets ---
# Real per-environment credentials - deploy/.env.example documents the shape.
deploy/.env

# --- Build artifacts ---
*.tar

# --- Reproducibility auditing (app/routers/reproducibility.py) ---
# Local scratch dirs - job status files and downloaded MLflow run artifacts,
# regenerated on demand, never meant to be committed.
/reproduction_jobs/
/reproduction_packages/
# DVC-tracked (cache: false, see dvc.yaml) but not meant to be committed -
# regenerated by every `dvc repro train`.
/metrics/
# src/train_optimal.py's own outputs - RFECV/Optuna artifacts (models/) and
# per-run logs (logs/), regenerated on every `dvc repro train_optimal`.
/models/
/logs/
