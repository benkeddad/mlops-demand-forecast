# Copy this file to .env (same folder) and adjust values for your environment.
# docker-compose.yaml reads these via ${VAR} substitution - Compose auto-loads
# ".env" from this directory because every deploy script invokes
# `docker-compose -f deploy/docker-compose.yaml` (Compose's project directory
# defaults to the directory of the first -f file when one is given).
#
# deploy/.env itself is gitignored so nobody's real credentials end up in
# version control - this .example file is the one that's committed.

POSTGRES_USER=user
POSTGRES_PASSWORD=Password
POSTGRES_DB=rossmann

# LocalStack S3 credentials - LocalStack ignores the actual values (any
# non-empty string works), these just need to be present and consistent
# between mlflow/api. Real AWS deployments override these with real keys.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
